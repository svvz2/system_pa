# Mobile (copy the relevant values to mobile/.env)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
EXPO_PUBLIC_GARAGE_ID=10000000-0000-4000-8000-000000000001

# Edge Functions (configure with `supabase secrets set` for cloud)
PII_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
PII_HMAC_KEY=replace-with-another-32-random-characters
DEVICE_MASTER_SECRET=replace-with-device-master-secret

# Simulator
SUPABASE_FUNCTIONS_URL=http://127.0.0.1:55321/functions/v1
DEVICE_ID=30000000-0000-4000-8000-000000000001
DEVICE_MASTER_SECRET=replace-with-device-master-secret
DEVICE_SYNC_INTERVAL_MS=1000
